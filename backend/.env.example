# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL 18) ---
# Create the `airec` database first (pgAdmin → Databases → Create → Database).
# DB_PASSWORD is the postgres password you set during installation.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airec
DB_USER=postgres
DB_PASSWORD=change-me

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Used instead of the above when the sign-in was not "remembered".
REFRESH_TOKEN_SESSION_TTL_HOURS=12
# How long a just-rotated refresh token is still read as the same client asking
# twice rather than as a stolen one being replayed. Two tabs share one
# localStorage, so a benign double-send is normal; without this window it ended
# every session the user had. Seconds only — anything later is a real replay.
REFRESH_TOKEN_REUSE_GRACE_SECONDS=10

# --- App ---
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
# Optional, dev only: lets a phone on the same Wi-Fi reach the API, whose
# origin is the machine's LAN address and changes with DHCP. Leave unset in
# production — a regex here is a list of origins nobody reviewed.
# CORS_ORIGIN_REGEX=http://192\.168\.\d+\.\d+:3000

# --- Password reset ---
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- WhatsApp Cloud API ---
# App-wide, from one Meta app: the secret signs every webhook it sends us, the
# verify token answers the one-time subscription handshake. The per-business
# half — the phone number id and its token — is pasted into the app itself and
# stored in `whatsapp_accounts`.
#
# Leave both unset in local dev. With no app secret the webhook refuses every
# delivery, which is the right answer for a machine Meta cannot reach; point
# ngrok at :8000 and fill these in when you want to test against a real number.
WHATSAPP_APP_SECRET=
# Anything you like — you type the same string into Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=
# Pinned, not "latest": Meta breaks fields between versions.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_TIMEOUT_SECONDS=10

# --- SMTP (optional) ---
# Leave SMTP_HOST unset for local dev — reset codes are logged to the server
# console instead of emailed. Fill these in to actually send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AIRec <no-reply@airec.local>
SMTP_USE_TLS=true
