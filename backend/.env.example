# Copy to .env and fill in. Never commit .env.

# --- Database (PostgreSQL 18) ---
# Create the `airec` database first (pgAdmin → Databases → Create → Database).
# DB_PASSWORD is the postgres password you set during installation.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airec
DB_USER=postgres
DB_PASSWORD=change-me

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- App ---
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Password reset ---
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- SMTP (optional) ---
# Leave SMTP_HOST unset for local dev — reset codes are logged to the server
# console instead of emailed. Fill these in to actually send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AIRec <no-reply@airec.local>
SMTP_USE_TLS=true
